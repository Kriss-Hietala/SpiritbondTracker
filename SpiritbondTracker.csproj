<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SpiritbondTracker</AssemblyName>
    <RootNamespace>SpiritbondTracker</RootNamespace>
    <!-- Allow overriding Dalamud path for CI -->
    <DalamudPath Condition="'$(DalamudPath)' == ''">$(DALAMUD_PATH)</DalamudPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lumina" Version="7.6.1" />
    <PackageReference Include="Lumina.Excel" Version="7.5.0" />
  </ItemGroup>
</Project>